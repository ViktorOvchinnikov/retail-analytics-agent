# Gemini API (Google AI Studio). Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Billing project for queries against the public dataset.
GOOGLE_CLOUD_PROJECT=your-gcp-project
BIGQUERY_LOCATION=US
BIGQUERY_DATASET=bigquery-public-data.thelook_ecommerce
BIGQUERY_MAX_BYTES=1073741824

# Mock employee authorization. Configure values returned by --list-brands.
MANAGER_1_BRANDS=Calvin Klein,Levi's
MANAGER_2_BRANDS=Carhartt

RETAIL_AGENT_DB_PATH=.retail-agent.sqlite3
RETAIL_AGENT_LOG_PATH=retail-agent.jsonl
RETAIL_AGENT_MIN_GROUP_SIZE=10
